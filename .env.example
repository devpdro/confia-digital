# Configurações de Email para Nodemailer
# Copie este arquivo para .env.local e preencha com suas credenciais

# Gmail (recomendado usar App Password)
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app-do-gmail

# Ou use outro provedor SMTP
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=seu-email@seuprovedor.com
# SMTP_PASS=sua-senha

# Email de destino para receber as simulações
DESTINATION_EMAIL=contato@confiacapital.com.br